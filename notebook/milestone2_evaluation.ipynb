    "def email_assistant(email_text):\n",
    "    text = email_text.lower()\n",
    "    if \"urgent\" in text or \"deadline\" in text or \"failed\" in text:\n",
    "        return \"notify\", \"urgent\"\n",
    "    elif \"thank you\" in text or \"please\" in text:\n",
    "        return \"ignore\", \"polite\"\n",
    "    elif \"sale\" in text or \"promotion\" in text:\n",
    "        return \"ignore\", \"neutral\"\n",
    "    else:\n",
    "        return \"respond\", \"neutral\""
   ]
