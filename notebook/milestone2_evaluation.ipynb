    "#STEP-3: Apply the email_assistant function to get assistant outputs\n",
    "def email_assistant(email_text):\n",
    "    email = email_text.lower()\n",
    "\n",
    "    if \"urgent\" in email or \"immediately\" in email:\n",
    "        return \"respond\", \"urgent\"\n",
    "    elif \"meeting\" in email:\n",
    "        return \"notify\", \"neutral\"\n",
    "    elif \"invoice\" in email or \"payment\" in email:\n",
    "        return \"respond\", \"polite\"\n",
    "    else:\n",
    "        return \"ignore\", \"neutral\"\n",
    "df[\"assistant_outputs\"] = df[\"email_text\"].apply(email_assistant)\n",
    "assistant_outputs = df[\"assistant_outputs\"]"
   ]
